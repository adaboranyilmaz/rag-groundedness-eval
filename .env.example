# Copy to .env and fill in. Never commit .env.

# Anthropic API key — used for the primary (API) generation and judge model.
ANTHROPIC_API_KEY=

# SEC EDGAR requires a descriptive User-Agent identifying the requester (name + contact
# email). Anonymous / generic user agents are rate-limited or blocked.
# https://www.sec.gov/os/webmaster-faq#developers
EDGAR_USER_AGENT=

# Ollama host, if not running on the default local port.
OLLAMA_HOST=http://localhost:11434

# MLflow tracking backend.
MLFLOW_TRACKING_URI=sqlite:///mlflow.db

# Qdrant (Phase 2, Docker), only needed when QDRANT is the selected vector-store backend.
QDRANT_HOST=localhost
QDRANT_PORT=6333
