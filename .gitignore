# --- secrets ---
.env

# --- internal planning doc ---
PROJECT_SPEC.md
DECISIONS.md

# --- data & indices (DVC-tracked, never git) ---
data/raw/*
data/processed/*
data/indices/*
!data/raw/.gitkeep
!data/processed/.gitkeep
!data/indices/.gitkeep
# the DVC pointer files for the pipeline's roots are committed (dvc.yaml)
!data/raw/*.dvc
# LLM response cache (the replay source; DVC-tracked)
data/cache/*
!data/cache/*.dvc

# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
.venv/
.venv-ragas/
venv/

# --- MLflow ---
mlruns/
mlflow.db
mlartifacts/

# --- DVC ---
/dvc.lock.tmp

# --- OS / editor ---
.DS_Store
.vscode/
.idea/

# --- misc build ---
dist/
build/
*.egg-info/

# generated labelling page (regenerate with scripts/06b_judge_validation.py sample)
results/labels/*.html

# adversarial-set review working file; its decisions are applied to questions.jsonl
