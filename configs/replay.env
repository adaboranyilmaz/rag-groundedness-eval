# Environment for pipeline rebuilds (dvc.yaml, CI). Every LLM response must come from the
# on-disk response cache and every EDGAR request from the EDGAR cache: a rebuild costs
# nothing, reads only the DVC-versioned raw data, and cannot produce new answers.
RAG_REPLAY_ONLY=1
EDGAR_OFFLINE=1
# A placeholder, so .env cannot supply the real key (load_dotenv does not override a set
# variable): a call that somehow got past replay-only mode would fail to authenticate.
ANTHROPIC_API_KEY=replay-only-no-key
